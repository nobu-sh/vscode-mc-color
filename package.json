{
  "name": "mc-color",
  "displayName": "Minecraft Color Highlighter",
  "description": "Highlight Minecraft colors in your editor 🔥",
  "publisher": "Nobuwu",
  "version": "3.0.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "icon": "public/logo.png",
  "bugs": {
    "url": "https://github.com/nobu-sh/vscode-mc-color/issues"
  },
  "homepage": "https://github.com/nobu-sh/vscode-mc-color",
  "repository": {
    "type": "git",
    "url": "https://github.com/nobu-sh/vscode-mc-color.git"
  },
  "activationEvents": [
    "onLanguage:*",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [],
    "configuration": {
      "title": "Minecraft Color Highlighter Options",
      "properties": {
        "mc-color.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/Disable Minecraft color highlighting."
        },
        "mc-color.prefixes": {
          "type": "array",
          "default": [
            "&",
            "§"
          ],
          "description": "List of prefixes to highlight."
        },
        "mc-color.version": {
          "type": "string",
          "default": "bedrock",
          "description": "Minecraft version to use for color codes.",
          "enum": [
            "bedrock",
            "bedrock-pre-1.19.70",
            "java"
          ]
        },
        "mc-color.marker": {
          "type": "string",
          "default": "foreground",
          "description": "Marker style for highlighting text.",
          "enum": [
            "foreground",
            "background",
            "outline",
            "underline"
          ]
        },
        "mc-color.fallback": {
          "type": "boolean",
          "default": true,
          "description": "Use fallback lexing on unrecognized languages."
        },
        "mc-color.fallbackRegex": {
          "type": "array",
          "default": [
            "(?<!\\\\)\"",
            "(?<!\\\\)'",
            "(?<!\\\\)`",
            "\\r?\\n"
          ],
          "description": "Fallback parsing regex. Default one will highlight infinitely stopping on newlines, and non escaped double quotes, single quotes, and backticks."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@ariesclark/eslint-config": "^2.1.0",
    "@types/mocha": "^10.0.8",
    "@types/node": "20.x",
    "@types/vscode": "^1.94.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.11.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.2"
  }
}
